<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0f1216"/>
      <stop offset="100%" stop-color="#161a1f"/>
    </linearGradient>
    <linearGradient id="seedGrad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#fd9b2f"/>
      <stop offset="100%" stop-color="#f77a1a"/>
    </linearGradient>
    <filter id="softGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="50" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bgGrad)"/>
  <circle cx="900" cy="-40" r="420" fill="#f78e1e" opacity="0.12" filter="url(#softGlow)"/>

  <!-- Seed / logo-like accent -->
  <g transform="translate(980,130) rotate(-15)">
    <path d="M0,-120 C66,-120 120,-66 120,0 C120,60 78,129 0,180 C-78,129 -120,60 -120,0 C-120,-66 -66,-120 0,-120 Z" fill="url(#seedGrad)"/>
  </g>

  <!-- Title and subtitle -->
  <g font-family="Segoe UI, Roboto, Ubuntu, Arial, sans-serif" fill="#e6e9ef">
    <text x="80" y="250" font-size="54" font-weight="800" letter-spacing="0.5">
      FL Studio for Windows
    </text>
    <text x="80" y="310" font-size="30" fill="#cbd5df">
      Download • Install • Optimize
    </text>
  </g>

  <!-- Footer line -->
  <g font-family="Segoe UI, Roboto, Ubuntu, Arial, sans-serif" fill="#9aa4ad">
    <text x="80" y="560" font-size="22">Official Windows installer • 64-bit • Safe CDN link</text>
    <text x="80" y="595" font-size="18">Independent resource — not affiliated with Image-Line</text>
  </g>
</svg>
